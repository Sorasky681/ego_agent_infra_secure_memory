{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egoagentos.dev/schemas/agentteams-trace.v1.json",
  "title": "Verified live AgentTeams benchmark trace",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "execution_mode",
    "synthetic",
    "seed",
    "scenario_id",
    "project_id",
    "task_id",
    "correlation_id",
    "trace_id",
    "context_version",
    "agents",
    "principals",
    "events",
    "rxp",
    "bridge",
    "official_contract",
    "official_response_identifiers",
    "snapshots",
    "bridge_event_chain",
    "scenario_proof",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": {"const": "egoagentos.agentteams-trace/v1"},
    "source": {"const": "AgentTeams"},
    "execution_mode": {"const": "real-agentteams"},
    "synthetic": {"const": false},
    "seed": {"type": "integer"},
    "scenario_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 8},
    "trace_id": {"type": "string", "minLength": 8},
    "context_version": {"type": "integer", "minimum": 1},
    "agents": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "role", "matrix_user_id", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "matrix_user_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "principals": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "kind", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["bridge", "human", "ego"]},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "type",
          "actor",
          "task_id",
          "correlation_id",
          "payload"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "correlation_id": {"type": "string", "minLength": 8},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "rxp": {
      "type": "object",
      "required": [
        "intent_digest",
        "grant_id",
        "receipt_digest",
        "evidence_digest",
        "matrix_root"
      ],
      "properties": {
        "intent_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "grant_id": {"type": "string", "minLength": 1},
        "receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "matrix_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "required": [
        "api_version",
        "benchmark_adapter_version",
        "endpoint",
        "run_id"
      ],
      "properties": {
        "api_version": {"type": "string", "minLength": 1},
        "benchmark_adapter_version": {"const": "rxp-bench/v1"},
        "endpoint": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "official_contract": {
      "type": "object",
      "required": ["repository", "main_commit", "api_version", "controller"],
      "properties": {
        "repository": {"const": "https://github.com/agentscope-ai/AgentTeams"},
        "main_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "api_version": {"const": "agentteams.io/v1beta1"},
        "controller": {"type": "object"}
      },
      "additionalProperties": false
    },
    "official_response_identifiers": {
      "type": "object",
      "required": [
        "project_id",
        "project_create_sha256",
        "matrix_root",
        "approval_matrix_event_id",
        "workflow_sha256"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "project_create_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "matrix_root": {"type": "string", "minLength": 1},
        "approval_matrix_event_id": {"type": "string", "minLength": 1},
        "workflow_sha256": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "snapshots": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "bridge_event_chain": {
      "type": "object",
      "required": ["valid", "total", "head", "source_ledger_total"],
      "properties": {
        "valid": {"const": true},
        "total": {"type": "integer", "minimum": 8},
        "head": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_ledger_total": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "scenario_proof": {
      "type": "object",
      "required": [
        "scenario_id",
        "required_event_types",
        "observed_event_types",
        "missing_event_types",
        "exactly_once_replay_verified",
        "replay_semantic_digests",
        "verified",
        "claim_boundary"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "required_event_types": {"type": "array", "items": {"type": "string"}},
        "observed_event_types": {"type": "array", "items": {"type": "string"}},
        "missing_event_types": {"type": "array", "items": {"type": "string"}},
        "exactly_once_replay_verified": {"type": "boolean"},
        "replay_semantic_digests": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "verified": {"type": "boolean"},
        "claim_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "truth_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
