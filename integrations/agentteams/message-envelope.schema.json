{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egoagentos.dev/schemas/agentteams-message-envelope.v1.json",
  "title": "AgentTeams collaboration envelope",
  "type": "object",
  "required": ["schema", "message_id", "task_id", "trace_id", "sender", "kind", "payload_ref", "created_at"],
  "properties": {
    "schema": {"const": "egoagentos.agent-message.v1"},
    "message_id": {"type": "string", "minLength": 8},
    "task_id": {"type": "string", "minLength": 3},
    "trace_id": {"type": "string", "minLength": 8},
    "sender": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "recipient": {"type": ["string", "null"]},
    "kind": {"enum": ["command", "artifact_ref", "review", "status", "approval_request"]},
    "stage": {"type": "string"},
    "payload_ref": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "pattern": "^ego://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

