{
  "components": {
    "schemas": {
      "AdvanceRequest": {
        "additionalProperties": false,
        "properties": {
          "approval_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Token"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "AdvanceRequest",
        "type": "object"
      },
      "ApprovalDecision": {
        "enum": [
          "approved",
          "denied"
        ],
        "title": "ApprovalDecision",
        "type": "string"
      },
      "ApprovalDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "approver": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Approver",
            "type": "string"
          },
          "decision": {
            "$ref": "#/components/schemas/ApprovalDecision"
          },
          "expected_digest": {
            "title": "Expected Digest",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "approver",
          "expected_digest"
        ],
        "title": "ApprovalDecisionRequest",
        "type": "object"
      },
      "AutorunRequest": {
        "additionalProperties": false,
        "properties": {
          "approval_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Token"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "title": "AutorunRequest",
        "type": "object"
      },
      "DemoResetRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "scenario": {
            "default": "happy_path",
            "enum": [
              "happy_path",
              "insufficient_evidence"
            ],
            "title": "Scenario",
            "type": "string"
          }
        },
        "title": "DemoResetRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Stage": {
        "enum": [
          "INTAKE",
          "CONTEXT",
          "PLAN",
          "PLAN_REVIEW",
          "APPROVAL",
          "EXECUTE",
          "OBSERVE",
          "EVALUATE",
          "VERIFY",
          "DECIDE",
          "ARCHIVE",
          "MEMORY_SKILL",
          "COMPLETED"
        ],
        "title": "Stage",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Evidence-gated, deterministic control plane for multi-agent embodied-AI research. The bundled EgoLite run is explicitly synthetic.",
    "title": "EgoAgentOS ResearchOps API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
