# Local-first defaults. Copy to .env and change secrets before any shared deployment.
EGO_ENV=development
EGO_API_HOST=0.0.0.0
EGO_API_PORT=8000
EGO_DB_PATH=./artifacts/runtime/egoagentos.sqlite3
# PostgreSQL takes precedence when set. Generate a local compose password with
# `openssl rand -hex 32`; never commit a shared/cloud password.
EGO_DATABASE_URL=
EGO_DATABASE_MIGRATION_MODE=apply
EGO_POSTGRES_DB=egoagentos
EGO_POSTGRES_USER=egoagentos
EGO_POSTGRES_PASSWORD=
EGO_POSTGRES_PORT=5432
EGO_TENANT_ID=local
EGO_ARTIFACT_ROOT=./artifacts/runtime
EGO_CORS_ORIGINS=http://localhost:4173,http://localhost:5173
# Optional shared control-plane/tool-plane signer. Leave empty for UI-only local replay;
# set an operator-generated value of at least 32 bytes for API → GPU MCP interoperability.
EGO_MCP_APPROVAL_HMAC_SECRET=

# Machine-to-machine token for AgentTeams Bridge → trusted-memory Focus Source API.
# Use one operator-generated secret of at least 32 bytes in both backend and bridge.
# `disabled` preserves the existing bridge path without a memory read. Production live
# AgentTeams deployments should use `required`; `best_effort` exposes failures explicitly.
EGO_TRUSTED_MEMORY_SERVICE_TOKEN=
EGO_FOCUS_MEMORY_MODE=disabled
EGO_FOCUS_MEMORY_TOKEN_BUDGET=4000
EGO_FOCUS_MEMORY_MAX_ITEMS=12
EGO_FOCUS_MEMORY_SOURCE_MAX_ITEMS=64
EGO_FOCUS_MEMORY_SCAN_LIMIT=512

# Optional platform adapters. Empty means "not configured", never "healthy".
EGO_HICLAW_URL=
AGENTTEAMS_MODEL=
AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:18080
AGENTTEAMS_AUTH_TOKEN=
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:18080
AGENTTEAMS_MATRIX_ACCESS_TOKEN=
# Explicit PostgreSQL/PolarDB-PG bridge runtime and migration-owner URLs. The Compose
# live profile defaults both to its local PostgreSQL service; shared deployments should
# use separate roles and secrets. Leave both empty only for SQLite development fallback.
EGO_AGENTTEAMS_DATABASE_URL=
EGO_AGENTTEAMS_MIGRATION_DATABASE_URL=
EGO_AGENTTEAMS_BRIDGE_DB=./artifacts/runtime/agentteams-bridge.sqlite3
EGO_AGENTTEAMS_HTTP_TIMEOUT=15
# Explicit live benchmark opt-in. When unset, the adapter returns lowercase skip.
AGENTTEAMS_BENCHMARK_LIVE=
# Path to an uncommitted, permission-restricted JSON mapping scenario IDs to real
# ego_task_id/objective/approval_token values. Never commit this file.
AGENTTEAMS_BENCHMARK_BINDINGS_FILE=
EGO_NACOS_URL=
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=
EGO_HIGRESS_URL=
HIGRESS_GATEWAY_URL=
HIGRESS_CONSUMER_TOKEN=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional Aliyun official Skill / SLS read-only integration.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=
ALIYUN_SLS_PROJECT=
ALIYUN_SLS_LOGSTORE=
